# Server Port
PORT=5000

# ----------------------------------------------------
# Hugging Face AI Configuration (meta-llama/Llama-3.1-8B-Instruct)
# ----------------------------------------------------
# 1. Cloud Serverless / Inference API mode (Recommended):
#    Get your access token from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# 2. Local Python Transformers Microservice mode:
#    Set USE_LOCAL_PYTHON_MODEL=true if running `python ai_service/app.py`
USE_LOCAL_PYTHON_MODEL=false
LOCAL_PYTHON_AI_URL=http://localhost:8000

# File Upload Limit
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=uploads
